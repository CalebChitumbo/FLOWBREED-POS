{
  "name": "flowbreeds-pos",
  "version": "0.1.0",
  "description": "Custom offline-first Point of Sale system for Flowbreeds Farms Shop",
  "author": "Flowbreeds Farms Shop",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win nsis",
    "rebuild": "electron-builder install-app-deps",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.6.2",
    "firebase-admin": "^12.7.0",
    "node-thermal-printer": "^4.6.0",
    "papaparse": "^5.5.3",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "9.6.0"
  },
  "devDependencies": {
    "@mantine/core": "^9.3.2",
    "@mantine/hooks": "^9.3.2",
    "@playwright/test": "^1.61.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "better-sqlite3-modern": "npm:better-sqlite3@^12.11.1",
    "electron": "22.3.27",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.9",
    "zustand": "^5.0.14"
  }
}
